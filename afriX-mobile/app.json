{
  "expo": {
    "name": "AfriX",
    "slug": "afriX",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "afrix",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nexgentech.afrix",
      "googleServicesFile": "./GoogleService-Info-7.plist",
      "buildNumber": "8",
      "entitlements": {},
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "whatsapp"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.nexgentech.afrix",
      "googleServicesFile": "./google-services.json",
      "versionCode": 9,
      "adaptiveIcon": {
        "backgroundColor": "#010B25",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "apiUrl": "https://afrix-iqvq.onrender.com/api/v1",
      "webUrl": "https://afri-x.vercel.app",
      "router": {},
      "eas": {
        "projectId": "15e39350-ebf9-47bf-84f1-7baafaa9da6a"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#010B25",
          "dark": {
            "backgroundColor": "#010B25"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AfriX to access your photos to upload payment proof",
          "cameraPermission": "Allow AfriX to use your camera to take photos of payment proof"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock AfriX and sign in securely with Face ID."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "codewithharz"
  }
}